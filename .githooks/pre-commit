#!/usr/bin/env bash
# Pre-commit hook for qi_flutter
# Runs the same checks as CI: formatting, linting, static analysis.
#
# Install: git config core.hooksPath .githooks
# Or:      make hooks
#
# Skip (emergency only): git commit --no-verify

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

errors=0

step() {
  printf "${YELLOW}► %s${NC}\n" "$1"
}

pass() {
  printf "${GREEN}  ✓ %s${NC}\n" "$1"
}

warn() {
  printf "${YELLOW}  ! %s${NC}\n" "$1"
}

fail() {
  printf "${RED}  ✗ %s${NC}\n" "$1"
  errors=$((errors + 1))
}

# ── Rust checks ──────────────────────────────────────────
if [ -d "rust" ]; then
  step "cargo fmt --all -- --check"
  if (cd rust && cargo fmt --all -- --check 2>&1); then
    pass "Rust formatting"
  else
    fail "Rust formatting — run: cd rust && cargo fmt --all"
  fi

  step "cargo clippy --all-targets --all-features -- -D warnings"
  if (cd rust && cargo clippy --all-targets --all-features -- -D warnings 2>&1); then
    pass "Clippy"
  else
    fail "Clippy — fix warnings in rust/"
  fi

  step "cargo test --workspace"
  if (cd rust && cargo test --workspace 2>&1); then
    pass "Rust tests"
  else
    fail "Rust tests — fix failing tests in rust/"
  fi
fi

# ── Dart/Flutter checks ─────────────────────────────────
if [ -f "app/flutter/pubspec.yaml" ]; then
  step "dart format --set-exit-if-changed lib/ test/"
  if (cd app/flutter && dart format --set-exit-if-changed lib/ test/ > /dev/null 2>&1); then
    pass "Dart formatting"
  else
    fail "Dart formatting — run: cd app/flutter && dart format lib/ test/"
  fi
fi

# ── Flutter <-> Rust (FRB) checks ───────────────────────
# Bindings, flutter analyze, flutter test, and unused FRB API functions.
# Exit code 3 means only unused functions were found. Unlike CI, the hook blocks
# them, because editors such as VS Code hide the output of a passing hook.
# FRB_ALLOW_UNUSED=1 confirms that committing them is intentional.
if [ -f "scripts/check_frb.sh" ]; then
  step "bash scripts/check_frb.sh"
  frb_status=0
  bash scripts/check_frb.sh 2>&1 || frb_status=$?
  if [ "$frb_status" -eq 0 ]; then
    pass "FRB checks"
  elif [ "$frb_status" -eq 3 ] && [ "${FRB_ALLOW_UNUSED:-}" = "1" ]; then
    warn "WARNING: unused FRB API functions, listed above. Committed on purpose (FRB_ALLOW_UNUSED=1)."
  elif [ "$frb_status" -eq 3 ]; then
    fail "Unused FRB API functions, listed above. Use them in app/flutter/lib/, mark them in Rust with '/// frb-api-usage: allow-unused (<reason>)', or commit on purpose: FRB_ALLOW_UNUSED=1 git commit"
  else
    fail "FRB checks — see the ERROR lines above"
  fi
fi

# ── Result ───────────────────────────────────────────────
echo ""
if [ "$errors" -gt 0 ]; then
  printf "${RED}Pre-commit failed with %d error(s). Fix and retry.${NC}\n" "$errors"
  exit 1
else
  printf "${GREEN}All pre-commit checks passed.${NC}\n"
fi
