#!/usr/bin/env bash
# Pre-commit hook for qi_flutter
# Runs the same checks as CI: formatting, linting, static analysis.
#
# Install: git config core.hooksPath .githooks
# Or:      make hooks
#
# Skip (emergency only): git commit --no-verify

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

errors=0

step() {
  printf "${YELLOW}► %s${NC}\n" "$1"
}

pass() {
  printf "${GREEN}  ✓ %s${NC}\n" "$1"
}

warn() {
  printf "${YELLOW}  ! %s${NC}\n" "$1"
}

fail() {
  printf "${RED}  ✗ %s${NC}\n" "$1"
  errors=$((errors + 1))
}

# ── Rust checks ──────────────────────────────────────────
if [ -d "rust" ]; then
  step "cargo fmt --all -- --check"
  if (cd rust && cargo fmt --all -- --check 2>&1); then
    pass "Rust formatting"
  else
    fail "Rust formatting — run: cd rust && cargo fmt --all"
  fi

  step "cargo clippy --all-targets --all-features -- -D warnings"
  if (cd rust && cargo clippy --all-targets --all-features -- -D warnings 2>&1); then
    pass "Clippy"
  else
    fail "Clippy — fix warnings in rust/"
  fi

  step "cargo test --workspace"
  if (cd rust && cargo test --workspace 2>&1); then
    pass "Rust tests"
  else
    fail "Rust tests — fix failing tests in rust/"
  fi
fi

# ── FRB bindings ────────────────────────────────────────
if [ -f "scripts/check_frb_bindings.sh" ]; then
  step "bash scripts/check_frb_bindings.sh"
  if bash scripts/check_frb_bindings.sh 2>&1; then
    pass "FRB bindings up to date"
  else
    fail "FRB bindings stale or not staged — review the regenerated files listed above and git add them"
  fi
fi

# ── Dart/Flutter checks ─────────────────────────────────
if [ -f "app/flutter/pubspec.yaml" ]; then
  step "dart format --set-exit-if-changed lib/ test/"
  if (cd app/flutter && dart format --set-exit-if-changed lib/ test/ > /dev/null 2>&1); then
    pass "Dart formatting"
  else
    fail "Dart formatting — run: cd app/flutter && dart format lib/ test/"
  fi

  step "flutter analyze"
  if (cd app/flutter && flutter analyze 2>&1 | tail -1 | grep -q "No issues found"); then
    pass "Flutter analyze"
  else
    fail "Flutter analyze — run: cd app/flutter && flutter analyze"
  fi

  # Warning only, like the non-blocking CI job. Exit code 1 means unused API
  # functions were found; any other failure means the check itself is broken.
  step "dart run tool/check_frb_api_usage.dart"
  frb_usage_status=0
  (cd app/flutter && dart run tool/check_frb_api_usage.dart 2>&1) || frb_usage_status=$?
  if [ "$frb_usage_status" -eq 0 ]; then
    pass "FRB API usage"
  elif [ "$frb_usage_status" -eq 1 ]; then
    warn "FRB API usage — unused functions listed above (warning, commit not blocked)"
  else
    fail "FRB API usage check crashed — run: cd app/flutter && dart run tool/check_frb_api_usage.dart"
  fi

  step "flutter test"
  if (cd app/flutter && flutter test 2>&1); then
    pass "Flutter tests"
  else
    fail "Flutter tests — fix failing tests in app/flutter/"
  fi
fi

# ── Template helper checks ────────────────────────────────
if [ -d "scripts/tests" ]; then
  step "python3 -m unittest discover -s scripts/tests -v"
  if python3 -m unittest discover -s scripts/tests -v 2>&1; then
    pass "Project rename tests"
  else
    fail "Project rename tests — fix scripts/tests/"
  fi
fi

# ── Result ───────────────────────────────────────────────
echo ""
if [ "$errors" -gt 0 ]; then
  printf "${RED}Pre-commit failed with %d error(s). Fix and retry.${NC}\n" "$errors"
  exit 1
else
  printf "${GREEN}All pre-commit checks passed.${NC}\n"
fi
